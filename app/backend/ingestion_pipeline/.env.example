# ============================================================================
# APP MODE - which of the three operating modes this deployment runs.
# See core/modes.py; the frontend's Modes tab shows the active one and any
# setup still missing for it.
#
#   sample      the bundled corpus into a LOCAL Neo4j. Nothing else to
#               configure - the "see it working" path.
#   production  real Kafka brokers + real Neo4j, running the DNIF -> Kafka ->
#               parse -> embed -> Neo4j realtime path. Requires the KAFKA_*
#               and DNIF_* settings below to be real.
#   custom      user-uploaded log files (Syslog/JSON/XML/CSV/CEF/LEEF/plain
#               text) parsed through the same core pipeline.
#
# An unrecognized value falls back to `sample` rather than failing to start.
# ============================================================================
APP_MODE=sample

# ============================================================================
# SERVICE ROLE - only used by `docker-compose --profile standalone` or when
# running main.py directly. The `producer` and `consumer` compose services
# set this themselves; you don't need to touch it for the default topology.
# ============================================================================
SERVICE_ROLE=standalone

# ============================================================================
# KAFKA CONFIGURATION - real 3-broker cluster provided by the infra team
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka-1.internal.example:9092,kafka-2.internal.example:9092,kafka-3.internal.example:9092
KAFKA_TOPIC_RAW_LOGS=raw-logs
KAFKA_TOPIC_PARSED_LOGS=parsed-logs
KAFKA_TOPIC_INSIGHTS=insights
KAFKA_CONSUMER_GROUP=log-ingestor-group
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ============================================================================
# NEO4J CONFIGURATION - the only datastore in this pipeline
# Community Edition only ever has a database named "neo4j"; a custom name is
# rejected unless the target is Enterprise Edition.
# ============================================================================
NEO4J_URI=bolt://neo4j.internal.example:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j
# Records per write transaction during bulk ingest. Higher = faster, but holds
# locks longer; 500 suits the corpus this pipeline loads.
NEO4J_BATCH_SIZE=500
# Maximum characters of the ORIGINAL raw log stored on (:Log).raw_message.
# The raw line is ALWAYS kept - `message` is a cleaned, normalized derivative,
# and forensic questions need the verbatim original. The cap exists because a
# reassembled multi-line record (a Windows Security Event body, a Java stack
# trace) can run to tens of KB and multiply the graph's on-disk size. Anything
# clipped is flagged with raw_truncated=true and raw_length on the node, so a
# truncated value can never be mistaken for the whole original.
# Set to 0 for genuinely unlimited.
RAW_MESSAGE_MAX_CHARS=32768

# ============================================================================
# DNIF CONFIGURATION
# ============================================================================
DNIF_API_URL=http://your-dnif-server:8080
DNIF_API_KEY=your-api-key-here
DNIF_TENANT=default
DNIF_POLL_INTERVAL=5
DNIF_BATCH_SIZE=100
DNIF_TIMEOUT=30

# ============================================================================
# EMBEDDING CONFIGURATION
# Vectors are stored on (:Log).embedding in Neo4j behind a native VECTOR INDEX.
# ============================================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ============================================================================
# CHATBOT (text-to-Cypher + GraphRAG, with a classifier routing between them)
# Point this at any Ollama instance on your network; the chatbot still works
# without one, it just returns retrieved rows/logs instead of prose answers.
# ============================================================================
CHATBOT_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
CHATBOT_TIMEOUT=120
# Below this confidence the router stops guessing and runs both strategies.
CHATBOT_ROUTER_THRESHOLD=0.6
CHATBOT_GRAPHRAG_TOP_K=8
CHATBOT_CYPHER_ROW_LIMIT=100
CHATBOT_MAX_CONTEXT_CHARS=12000

# ============================================================================
# PIPELINE TOGGLES
# ============================================================================
ENABLE_KAFKA=true
ENABLE_EMBEDDINGS=true
ENABLE_NEO4J=true
ENABLE_DNIF_EXTRACTOR=true
ENABLE_QWEN_FALLBACK=false

# ============================================================================
# INGESTION CONTROL API (api.py) - what the frontend's Modes tab and the
# custom-log upload talk to. Read-only elsewhere; this is the only service
# that writes to the graph on demand.
# ============================================================================
INGEST_API_HOST=0.0.0.0
INGEST_API_PORT=8020
# Comma-separated origins, or '*' for any. '*' is fine on a private VM.
INGEST_API_CORS_ORIGINS=*
# Largest single custom-log upload accepted, in MB. nginx.conf's
# client_max_body_size for /ingest-api/ should be kept at least this large.
INGEST_MAX_UPLOAD_MB=200

# ============================================================================
# SITE NAMING  (optional - affects UNKNOWN log sources only)
# ============================================================================
# When a record matches none of the built-in format detectors, the fallback
# extractor still recovers a hostname structurally: from an explicit
# host=/hostname=/dvchost= field, or from the syslog host slot (the token
# straight after the timestamp). Those rules hold on any network and need no
# configuration.
#
# These two settings only add a preference on top, for estates whose device
# names follow a local convention that no positional rule can infer. Leave
# them alone unless a new source's hostnames are coming through wrong.
#
# Comma-separated domain suffixes. A candidate ending in one of these is
# preferred over an arbitrary FQDN found elsewhere in the line.
ULPF_SITE_DOMAINS=corp.example,apps.svc.cluster.local,local
# Optional regex for hosts that follow a local naming scheme but carry no
# domain suffix. Group 1 - or the whole match - is taken as the hostname.
# Set to an empty value to disable.
ULPF_HOST_PATTERN=\b(MD[\w\-.]+|md-[\w\-]+)\b

# ============================================================================
# ADVANCED
# ============================================================================
LOG_LEVEL=INFO
CHUNK_SIZE=1000
MAX_WORKERS=4
