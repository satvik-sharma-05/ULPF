# ============================================================================
# NEO4J - the graph the ingestion pipeline built.
# Community Edition only ever has a database named "neo4j".
# ============================================================================
NEO4J_URI=bolt://neo4j.internal.example:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# ============================================================================
# ANALYTICS - tunables for the aggregation queries and rule-based insights.
# ============================================================================
# A host/source needs at least this many logs before its error RATE is used
# for a ranking/insight - otherwise a host with 2 logs and 1 error "wins"
# every ranking at a meaningless 50%.
ANALYTICS_MIN_VOLUME=20
ANALYTICS_TOP_N=10
# Cap on how many calendar days a /timeseries call can return in one response.
ANALYTICS_TIMESERIES_MAX_DAYS=90
# Trend insight compares this many recent days against the same number of
# days before that.
ANALYTICS_TREND_WINDOW_DAYS=7
# How long an aggregation is cached in-process before being recomputed. This
# is a batch-ingested historical corpus, not a live stream, so a short cache
# turns a multi-panel dashboard + auto-refresh into a handful of Neo4j round
# trips instead of one per panel per poll.
ANALYTICS_CACHE_TTL_SECONDS=30

# ============================================================================
# API - the FastAPI backend the analytics dashboard talks to (api.py)
# ============================================================================
ANALYTICS_API_HOST=0.0.0.0
ANALYTICS_API_PORT=8010
# Comma-separated origins, or '*' for any. '*' is fine for a demo on a private
# VM; tighten this before exposing the API anywhere less trusted.
ANALYTICS_API_CORS_ORIGINS=*
