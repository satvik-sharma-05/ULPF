# ============================================================================
# NEO4J - the graph the ingestion pipeline built.
# Community Edition only ever has a database named "neo4j".
# ============================================================================
NEO4J_URI=bolt://neo4j.internal.example:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# ============================================================================
# LLM - used for routing, Cypher generation and answer synthesis.
# Optional: without it the chatbot returns retrieved rows and log lines
# instead of prose, but still routes and retrieves normally.
# ============================================================================
# Which provider this process STARTS on. The Chat tab's LLM toggle can switch
# it at runtime (POST /api/llm) without a restart, but that switch is
# process-local and deliberately not persisted - a restart comes back to
# whatever is set here. Persisting it would let a button press silently and
# permanently repoint an airgapped deployment at a cloud API.
#   ollama     - a model running on this machine. The airgapped choice.
#   groq       - Groq's cloud API. Needs outbound internet.
#   openrouter - OpenRouter's cloud API. Needs outbound internet.
CHATBOT_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
CHATBOT_TIMEOUT=120

# Cloud provider credentials. Only needed if you actually switch to one -
# leave them unset on an airgapped VM. NEVER commit a real key: this file is
# the committed example, and the real values belong in .env (which
# .dockerignore already excludes from every image).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================================================
# EMBEDDINGS - MUST match what the ingestion pipeline stored on (:Log).embedding.
# A different model or dimension here returns meaningless neighbours: the vector
# index accepts any 1024-float query, it just can't tell the vectors came from a
# different embedding space.
#
# EMBEDDING_MODEL/RERANKER_MODEL accept a Hugging Face hub id (downloads on
# first load) or a local directory path containing a model snapshot. The
# Docker image bakes both models in at build time (see Dockerfile) so the
# running container never needs either - these only matter when running
# chat.py/api.py directly, outside Docker.
# ============================================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
NEO4J_VECTOR_INDEX=log_embedding_index
NEO4J_FULLTEXT_INDEX=log_message_fulltext

# ============================================================================
# RERANKER - cross-encoder re-scoring of pooled planner evidence before it
# reaches the final-answer prompt. Optional: without it (or if the model isn't
# downloaded) evidence just keeps its retrieval order - never a crash.
# ============================================================================
CHATBOT_RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
CHATBOT_RERANKER_TOP_N=15

# ============================================================================
# ROUTING / RETRIEVAL
# ============================================================================
# Below this confidence the router runs both strategies instead of guessing.
CHATBOT_ROUTER_THRESHOLD=0.6
CHATBOT_GRAPHRAG_TOP_K=8
CHATBOT_GRAPHRAG_NEIGHBOURS=16
CHATBOT_CYPHER_ROW_LIMIT=100
CHATBOT_MAX_CONTEXT_CHARS=12000
# Read the schema from the live database instead of a hard-coded description.
CHATBOT_INTROSPECT_SCHEMA=true
CHATBOT_SCHEMA_SAMPLE=3
# Planner ("auto" mode) hard caps - bound the worst-case cost of a plan that
# never converges (each round costs one LLM call plus its tool calls).
CHATBOT_PLANNER_MAX_ROUNDS=3
CHATBOT_PLANNER_MAX_TOOL_CALLS=6
CHATBOT_PLANNER_MAX_ROWS_PER_TOOL=20

# ============================================================================
# API - the FastAPI backend the demo frontend talks to (api.py)
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins, or '*' for any. '*' is fine for a demo on a private
# VM; tighten this before exposing the API anywhere less trusted.
API_CORS_ORIGINS=*

# ============================================================================
# SPEECH-TO-TEXT VOCABULARY - Whisper conditions on this text, so naming the
# hostnames and platforms that actually occur here is what took word error
# rate from 25% to 10%. Kept in .env rather than in source: the terms worth
# seeding are the deployment's real hostnames, which are exactly the terms not
# to publish in a public repository.
# ============================================================================
WHISPER_PROMPT=Log analytics questions. Hostnames like nsx-mgr-01, esx-gpu-02, nsx-edge-01. Severities ERROR WARNING CRITICAL NOTICE INFO DEBUG. Platforms ESXi, NSX, vCenter, vROps, Horizon, Kubernetes, CoreDNS, PostgreSQL.
